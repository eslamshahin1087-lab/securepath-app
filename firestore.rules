rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;

      function isValidActivity(activity) {
        // خريطة الأنشطة المسموحة وقيمها (هنا ننقل المنطق من المتصفح إلى السيرفر)
        return activity in {
          'walking': 5,
          'running': 8,
          'driving': 6,
          'assessment': 30,
          'docUpload': 10,
          'diversify': 50,
          'renewal': 40,
          'profileComplete': 20,
          'referral': 15
        };
      }

      function getPointsForActivity(activity) {
        return {
          'walking': 5,
          'running': 8,
          'driving': 6,
          'assessment': 30,
          'docUpload': 10,
          'diversify': 50,
          'renewal': 40,
          'profileComplete': 20,
          'referral': 15
        }[activity];
      }

      // منع التكرار: يجب أن يكون آخر نشاط منذ أكثر من 12 ساعة (43200 ثانية)
      function isNotDuplicate() {
        return (!('lastActivityAt' in resource.data)) || 
               (request.resource.data.lastActivityAt > resource.data.lastActivityAt + 43200);
      }

      allow update: if request.resource.data.diff(resource.data).affectedKeys.hasOnly(['points', 'lastActivityAt', 'insuraPointsLifetime']) &&
                     request.resource.data.points == resource.data.points + getPointsForActivity(request.resource.data.activityType) &&
                     isValidActivity(request.resource.data.activityType) &&
                     isNotDuplicate() &&
                     request.resource.data.insuraPointsLifetime == resource.data.insuraPointsLifetime + getPointsForActivity(request.resource.data.activityType);
    }
  }
}
